<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Debug only: the local Keycloak and API run over plain http. Release builds stay https-only. -->
    <application android:usesCleartextTraffic="true" tools:targetApi="28">
        <!-- Debug only: the local invite email links to http://localhost:5173/activate#token=...
             (PIXOREX_INVITE_BASE_URL). Approve it once per install, see mobile/README.md.
             PROVISIONAL until the real link format is decided (handover section 2). -->
        <activity android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="http" android:host="localhost" android:port="5173" android:pathPrefix="/activate"/>
            </intent-filter>
        </activity>
    </application>
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
</manifest>
