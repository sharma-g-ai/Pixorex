# Copy to .env (git-ignored) only if you need to change a local default. Never commit .env.

# Keycloak ports on your machine, if 8080 or 9100 are already used by something else.
# KC_HTTP_PORT and KC_HOSTNAME must use the same port.
# KC_HTTP_PORT=8180
# KC_MGMT_PORT=9101
# KC_HOSTNAME=http://localhost:8180

# Phone testing on the same Wi-Fi: use the laptop's LAN IP so tokens carry the same issuer everywhere.
# KC_HOSTNAME=http://192.168.1.50:8080

# ---------------------------------------------------------------------------------------------------
# SMS for one-time codes. Default "mailpit" puts every SMS in http://localhost:8025 (no phone needed).
# To send real texts locally, set KC_SMS_PROVIDER=amzur and fill in the gateway values below.
# PASTE REAL VALUES ONLY INTO .env, NEVER INTO THIS FILE. In deployed environments they come from Vault.
# ---------------------------------------------------------------------------------------------------
# KC_SMS_PROVIDER=amzur
# PIXOREX_SMS_URL=https://<gateway-host>/<send-path>
# PIXOREX_SMS_AUTH_HEADER=Authorization
# PIXOREX_SMS_AUTH_VALUE=Bearer <api-key>
# PIXOREX_SMS_SENDER=<registered-sender-id>
# PIXOREX_SMS_FORMAT=json
# Placeholders: {to} (+15550100001), {to_digits} (15550100001), {sender}, {text}
# PIXOREX_SMS_BODY_TEMPLATE={"to":"{to}","from":"{sender}","text":"{text}"}

# Audit events. Defaults post to the API (POST /internal/keycloak-events); the API checks them
# with the same secret (Vault outside local). To only print them, use the local "event-sink":
# PIXOREX_AUDIT_ENDPOINT=http://event-sink:8888/internal/keycloak-events
# PIXOREX_AUDIT_SECRET=<shared-hmac-secret>

# ---------------------------------------------------------------------------------------------------
# API (api/README.md). Docker Compose sets these for the api service; you need them only when
# running uvicorn on your machine. The API always connects as pixorex_app, never as the owner.
# ---------------------------------------------------------------------------------------------------
# PIXOREX_DATABASE_URL=postgresql://pixorex_app:local-only@localhost:5433/pixorex
# PIXOREX_MIGRATIONS_DATABASE_URL=postgresql://pixorex_owner:local-only@localhost:5433/pixorex
# PIXOREX_OIDC_ISSUER=http://localhost:8180/realms/pixorex      # the iss in tokens (KC_HOSTNAME + /realms/pixorex)
# PIXOREX_MINIO_URL=http://localhost:9000
# PIXOREX_VAULT_URL=http://localhost:8200
# PIXOREX_KEYCLOAK_ADMIN_SECRET=<Keycloak Clients -> pixorex-api-admin -> Credentials>
# PIXOREX_INVITE_BASE_URL=http://localhost:5173
# Invite email: Mailpit locally (default localhost:1025). For real mail, the realm's SMTP provider:
# PIXOREX_SMTP_HOST=<smtp host>
# PIXOREX_SMTP_PORT=587
# PIXOREX_SMTP_USER=<smtp user>
# PIXOREX_SMTP_PASSWORD=<smtp password or API key>
# PIXOREX_SMTP_STARTTLS=true
# PIXOREX_SMTP_FROM=<sender address>
