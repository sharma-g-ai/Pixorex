# Copy to .env (git-ignored) only if you need to change a local default. Never commit .env.

# Keycloak ports on your machine, if 8080 or 9100 are already used by something else.
# KC_HTTP_PORT and KC_HOSTNAME must use the same port.
# KC_HTTP_PORT=8180
# KC_MGMT_PORT=9101
# KC_HOSTNAME=http://localhost:8180

# Phone testing on the same Wi-Fi: use the laptop's LAN IP so tokens carry the same issuer everywhere.
# KC_HOSTNAME=http://192.168.1.50:8080

# ---------------------------------------------------------------------------------------------------
# SMS for one-time codes. Default "mailpit" puts every SMS in http://localhost:8025 (no phone needed).
# To send real texts locally, set KC_SMS_PROVIDER=amzur and fill in the gateway values below.
# PASTE REAL VALUES ONLY INTO .env, NEVER INTO THIS FILE. In deployed environments they come from Vault.
# ---------------------------------------------------------------------------------------------------
# KC_SMS_PROVIDER=amzur
# PIXOREX_SMS_URL=https://<gateway-host>/<send-path>
# PIXOREX_SMS_AUTH_HEADER=Authorization
# PIXOREX_SMS_AUTH_VALUE=Bearer <api-key>
# PIXOREX_SMS_SENDER=<registered-sender-id>
# PIXOREX_SMS_FORMAT=json
# Placeholders: {to} (+15550100001), {to_digits} (15550100001), {sender}, {text}
# PIXOREX_SMS_BODY_TEMPLATE={"to":"{to}","from":"{sender}","text":"{text}"}

# Audit events. Defaults post to the local mock "event-sink". Point them at the API once
# POST /internal/keycloak-events exists, with the shared secret the API also uses (Vault outside local).
# PIXOREX_AUDIT_ENDPOINT=http://api:8000/internal/keycloak-events
# PIXOREX_AUDIT_SECRET=<shared-hmac-secret>

# ---------------------------------------------------------------------------------------------------
# FastAPI (Slice S2). See docs/api-slice-s2-invite-signin-plan.md and api/README.md.
# DATABASE_* host is "postgres" inside Compose, "localhost" when uvicorn runs on the host.
# ---------------------------------------------------------------------------------------------------
# DATABASE_URL=postgresql://pixorex_app:local-only@localhost:5433/pixorex
# DATABASE_OWNER_URL=postgresql://pixorex_owner:local-only@localhost:5433/pixorex
# (Compose maps app Postgres to host port 5433; inside Docker keep host "postgres" and port 5432.)
# KC_ISSUER=http://localhost:8180/realms/pixorex
# When API is in Docker but browser tokens use localhost issuer:
# KC_PUBLIC_ISSUER=http://localhost:8180/realms/pixorex
# KC_API_ADMIN_CLIENT_ID=pixorex-api-admin
# KC_API_ADMIN_SECRET=<Keycloak Clients → pixorex-api-admin → Credentials>
# INVITE_APP_BASE_URL=http://localhost:5173
# Invite email SMTP. Mailpit locally, or the same SendGrid settings as Keycloak realm SMTP.
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=<SendGrid API key>
# SMTP_STARTTLS=true
# SMTP_FROM=myworkmate@amzur.com
# SMTP_FROM_NAME=Pixorex
