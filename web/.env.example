# Sign-in (decision D-11). Copy to .env.local for local work, or set in the build environment.
# Leave both empty in development to use mock auth (no Keycloak) — still needs an API (real or Prism).
# A production build without them shows "Sign-in isn't configured" and does not run.

# Keycloak realm URL, e.g. http://localhost:8180/realms/pixorex
VITE_OIDC_AUTHORITY=
# Public client of the dashboard in that realm (code + PKCE, no secret)
VITE_OIDC_CLIENT_ID=pixorex-web

# Dev proxy target for /api/v1 (vite.config.ts). Default: real FastAPI on :8000.
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000
# Prism mock (npm run api:mock):
# VITE_API_PROXY_TARGET=http://127.0.0.1:4010
